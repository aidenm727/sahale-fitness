# ~/.config/sahale/release.env on the laptop (outside git): what deploy/release and deploy/rollback need to
# reach the host. Placeholders only here; never commit the real values.
# The ssh alias from ~/.ssh/config that logs in to the host as the admin account.
SAHALE_SSH=<ssh-alias>
# The admin account on the host: owns /opt/sahale and ~/sahale-release, and runs sudo.
SAHALE_ADMIN=<admin>
# There is no setting for passwordless sudo: each run asks for the password once.
