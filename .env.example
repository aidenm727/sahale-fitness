# Copy to .env (gitignored) for local development. Real environment variables win over this file.
# ~/.local/share/sahale*, /var/lib/sahale* and ~/sahale-release are the owner's real stores, listed so a
# dev run can't open them. The runtime refuses those unless SAHALE_ALLOW_DATA_DIR names the exact path.
SAHALE_DATA_DIR=./.data/dev
SAHALE_PORT=4311
