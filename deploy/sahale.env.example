# /etc/sahale/sahale.env  (root:root 0644; no secrets belong here)
# The HTTPS origin Tailscale Serve exposes Sahale on. On a host where another service
# already owns :443 on the tailnet address (e.g. Traefik), use a separate Serve port.
SAHALE_PUBLIC_ORIGIN=https://<host>.<tailnet>.ts.net:8443
# The Tailscale login allowed in (`tailscale whois <phone 100.x address>` → User).
SAHALE_OWNER_LOGIN=<you@example.com>
# Leave SAHALE_HOST unset: the runtime must stay on 127.0.0.1 behind Serve.
