# A consistent copy of the live database for the host's file-level backups (Restic) to pick up.
[Unit]
Description=Sahale database snapshot
After=sahale.service

[Service]
Type=oneshot
User=sahale
Group=sahale
StateDirectory=sahale sahale/snapshots
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 /opt/sahale/app/deploy/sahale-sqlite.py snapshot /var/lib/sahale/sahale.db /var/lib/sahale/snapshots/sahale-latest.db
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
