{
  "name": "sahale-fitness",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "author": "Aiden Menefee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidenm727/sahale-fitness.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n runtime,web -c green,blue \"npm:server:watch\" \"npm:web\"",
    "web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "server:watch": "tsx watch --clear-screen=false --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "SAHALE_SERVE_STATIC=1 tsx --env-file-if-exists=.env server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db": "tsx --env-file-if-exists=.env server/scripts/db.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
